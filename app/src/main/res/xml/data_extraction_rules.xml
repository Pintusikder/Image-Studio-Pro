<?xml version="1.0" encoding="utf-8"?>
<!--
   Phase 12 Privacy Hardening (Android 12+ API 31+):
   Prevent automatic cloud extraction of sensitive image history databases and local exports.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="image_studio_database" />
        <exclude domain="database" path="image_studio_database-shm" />
        <exclude domain="database" path="image_studio_database-wal" />
        <exclude domain="file" path="exports" />
        <exclude domain="file" path="shared_temp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="shared_temp" />
    </device-transfer>
</data-extraction-rules>
